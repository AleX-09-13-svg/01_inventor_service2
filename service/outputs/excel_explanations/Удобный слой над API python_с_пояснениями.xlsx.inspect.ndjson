{"kind":"table","sheet":"Лист1","address":"A1:E26","rows":26,"cols":5,"values":[[null,null,null,null,"Пояснение"],[null,null,null,null,""],[null,"inventor_service/",null,null,"Корневая папка проекта с библиотекой и вспомогательными материалами."],[null,"├─ pyproject.toml",null,null,"Описание пакета, зависимостей, версии Python и настроек сборки."],[null,"├─ README.md",null,null,"Краткое описание назначения библиотеки, установки и базовых примеров."],[null,"├─ examples/",null,null,"Папка с готовыми сценариями использования API."],[null,"│  ├─ create_part.py",null,null,"Пример создания новой детали Inventor из Python."],[null,"│  ├─ color_selected_face.py",null,null,"Пример применения цвета к выбранной грани модели."],[null,"│  └─ drill_holes_on_face.py",null,null,"Пример создания отверстий на выбранной грани или по точкам эскиза."],[null,"├─ inventor_lib/",null,null,"Основной пакет библиотеки поверх Inventor API."],[null,"│  ├─ __init__.py",null,null,"Публичные импорты: Inventor, константы и часто используемые функции."],[null,"│  ├─ app.py",null,null,"Главный фасад подключения к Inventor и доступ к подсистемам библиотеки."],[null,"│  ├─ constants.py",null,null,"Именованные константы Inventor API вместо числовых значений в коде."],[null,"│  ├─ units.py",null,null,"Функции перевода единиц, например миллиметры в внутренние единицы Inventor."],[null,"│  ├─ errors.py",null,null,"Исключения библиотеки: ошибки подключения, выбора объектов и операций API."],[null,"│  ├─ transactions.py",null,null,"Контекстные менеджеры для безопасных транзакций Inventor."],[null,"│  ├─ types.py",null,null,"Protocol-типы для COM-объектов, чтобы IDE подсказывала свойства и методы."],[null,"│  ├─ documents.py",null,null,"Создание, открытие, сохранение и обновление документов Inventor."],[null,"│  ├─ selection.py",null,null,"Работа с SelectSet и интерактивным выбором деталей, граней и других объектов."],[null,"│  ├─ sketches.py",null,null,"Создание эскизов и базовых 2D-примитивов: линии, прямоугольники, окружности."],[null,"│  ├─ features.py",null,null,"Операции модели: отверстия, выдавливания, фаски, скругления и другие features."],[null,"│  ├─ appearances.py",null,null,"Работа с внешними видами, материалами, цветами и AppearanceAssets."],[null,"│  └─ geometry.py",null,null,"Вспомогательная геометрия: точки, коллекции, вершины, грани и обход COM-коллекций."],[null,"└─ tests/",null,null,"Папка с автоматическими тестами для независимых частей библиотеки."],[null,"   ├─ test_units.py",null,null,"Тесты для функций перевода единиц измерения."],[null,"   └─ test_collection_helpers.py",null,null,"Тесты для помощников обхода и обработки коллекций Inventor API."]]}
