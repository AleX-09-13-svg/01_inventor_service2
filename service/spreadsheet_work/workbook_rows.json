це параметров."}, {"B45": "│  │  ├─ excel.py", "G45": "Чтение и запись Excel-данных."}, {"B46": "│  │  ├─ parameters.py", "G46": "Имена, алиасы и проверка параметров."}, {"B47": "│  │  │     ├─ build_linked_parameters()", "G47": "Создает список связанных параметров из исходных имен."}, {"B48": "│  │  │     ├─ resolve_parameter_name()", "G48": "Учитывает алиасы при поиске имени параметра."}, {"B49": "│  │  │     └─ validate_library_config()", "G49": "Проверяет ссылки конфигурации на доступные параметры."}, {"B50": "│  │  └─ refresh.py", "G50": "Обновление конфигурации из Excel."}, {"B51": "│  │        ├─ refresh_linked_parameters_from_excel()", "G51": "Обновляет linked_parameters в JSON-файле."}, {"B52": "│  │        └─ schedule_linked_parameters_refresh()", "G52": "Планирует обновление конфигурации после открытия Inventor."}, {"B53": "│  ├─ assembly/", "G53": "Свойства и методы работы со сборками."}, {"B54": "│  │  ├─ __init__.py", "G54": "Экспорт API сборок."}, {"B55": "│  │  ├─ properties.py", "G55": "Свойства assembly_document, component_definition и occurrences."}, {"B56": "│  │  └─ methods.py", "G56": "Методы сборок."}, {"B57": "│  │        └─ def pick_part(prompt_text)", "G57": "Выбирает конечное вхождение детали в сборке."}, {"B58": "│  ├─ drawing/", "G58": "Свойства и методы работы с чертежами."}, {"B59": "│  │  ├─ __init__.py", "G59": "Экспорт API чертежей."}, {"B60": "│  │  ├─ properties.py", "G60": "Свойства drawing_document и sheets."}, {"B61": "│  │  └─ methods.py", "G61": "Зарезервированное место для методов чертежей."}, {"B62": "│  └─ part/", "G62": "Свойства и методы работы с деталями."}, {"B63": "│     ├─ __init__.py", "G63": "Экспорт API деталей."}, {"B64": "│     ├─ methods.py", "G64": "Сборщик PartMethods."}, {"B65": "│     │  └─ PartMethods", "G65": "Объединяет конфигурацию, геометрию, тела, эскизы и отверстия."}, {"B66": "│     ├─ properties.py", "G66": "Свойства детали и ее ComponentDefinition."}, {"B67": "│     └─ component_definition/", "G67