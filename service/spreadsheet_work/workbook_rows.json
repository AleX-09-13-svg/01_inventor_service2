s()", "G87": "Создает обычные отверстия по точкам эскиза."}, {"B88": "│        │           ├─ add_counterbore_holes()", "G88": "Создает отверстия с цековкой."}, {"B89": "│        │           ├─ add_hole_batch(), add_counterbore_batch()", "G89": "Создает группы отверстий с общими настройками."}, {"B90": "│        │           ├─ create_hole_batch_with_fallback()", "G90": "Ключевой внутренний путь с резервным сценарием создания."}, {"B91": "│        │           └─ set_all_bodies_affected()", "G91": "Назначает фичу на все тела многотельной детали."}, {"B92": "│        ├─ parameters/", "G92": "Пакет методов параметров ComponentDefinition."}, {"B93": "│        │  └─ __init__.py", "G93": "Зарезервированная точка расширения параметров."}, {"B94": "│        ├─ surface_bodies/", "G94": "Тела, грани, ребра и геометрия."}, {"B95": "│        │  ├─ __init__.py", "G95": "Экспорт методов тел."}, {"B96": "│        │  ├─ methods.py", "G96": "Сборщик методов SurfaceBodies."}, {"B97": "│        │  │  └─ PartSurfaceBodiesMethods", "G97": "Работа с одним или всеми телами детали."}, {"B98": "│        │  │     ├─ surface_body()", "G98": "Возвращает тело по индексу."}, {"B99": "│        │  │     └─ all_surface_bodies()", "G99": "Возвращает ObjectCollection всех тел."}, {"B100": "│        │  └─ surface_body/", "G100": "Методы отдельных тел и их элементов."}, {"B101": "│        │     ├─ __init__.py", "G101": "Пакет SurfaceBody."}, {"B102": "│        │     ├─ edges/__init__.py", "G102": "Методы ребер."}, {"B103": "│        │     ├─ faces/", "G103": "Методы граней и их геометрии."}, {"B104": "│        │     │  ├─ __init__.py", "G104": "Экспорт методов граней."}, {"B105": "│        │     │  ├─ geometry.py", "G105": "Сравнение плоскостей и координат."}, {"B106": "│        │     │  │     ├─ plane_geometry()", "G106": "Извлекает геометрию плоскости у сущности."}, {"B107": "│        │     │  │     ├─ same_plane_entity()", "G107": "Проверяет совпадение плоскостей со смещением."}, {"B108": "│        │